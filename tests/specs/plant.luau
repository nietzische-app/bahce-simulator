local T = require("../mocks/test")
local F = require("../mocks/fixtures")

return function()
	local l = F.serverLoader()
	local PlantService = l:require("ServerScriptService.Server.Systems.PlantService")
	local Game = l:require("ReplicatedStorage.Shared.Config.Game")
	local Seeds = l:require("ReplicatedStorage.Shared.Config.Seeds")

	T.describe("PlantService", function()
		T.it("MaxSlots = base + clamped extra", function()
			T.eq(PlantService.MaxSlots(F.newData()), Game.BASE_PLOT_SLOTS)
			local d = F.newData({ upgrades = { extraSlots = 2, growthSpeedLevel = 0 } })
			T.eq(PlantService.MaxSlots(d), Game.BASE_PLOT_SLOTS + 2)
			d.upgrades.extraSlots = 99
			T.eq(PlantService.MaxSlots(d), Game.BASE_PLOT_SLOTS + Game.MAX_EXTRA_SLOTS)
		end)

		T.it("Plant consumes a seed and occupies slot", function()
			local d = F.newData({ inventory = { SunBloom = 2 } })
			local ok = PlantService.Plant(d, "SunBloom", 1)
			T.ok(ok)
			T.eq(d.inventory.SunBloom, 1)
			T.eq(#d.plants, 1)
			T.eq(d.plants[1].slotIndex, 1)
		end)

		T.it("Plant rejects bad seed, locked slot, occupied slot, empty inventory", function()
			local d = F.newData({ inventory = { SunBloom = 5 } })
			T.eq((PlantService.Plant(d, "Nope", 1)), false)
			T.eq((PlantService.Plant(d, "SunBloom", 0)), false)
			T.eq((PlantService.Plant(d, "SunBloom", Game.BASE_PLOT_SLOTS + 1)), false)
			T.ok((PlantService.Plant(d, "SunBloom", 2)))
			T.eq((PlantService.Plant(d, "SunBloom", 2)), false)
			T.eq((PlantService.Plant(d, "DewLeaf", 3)), false)
			T.eq(d.inventory.SunBloom, 4)
		end)

		T.it("Plant rejects NaN / fractional slot index", function()
			local d = F.newData({ inventory = { SunBloom = 5 } })
			T.eq((PlantService.Plant(d, "SunBloom", 0 / 0)), false, "NaN")
			T.eq((PlantService.Plant(d, "SunBloom", 1.5)), false, "1.5")
			T.eq(d.inventory.SunBloom, 5)
			T.eq(#d.plants, 0)
		end)

		T.it("growth: not ready right after planting, ready after grow time", function()
			local d = F.newData({ inventory = { SunBloom = 1 } })
			PlantService.Plant(d, "SunBloom", 1)
			local p = d.plants[1]
			local prog, ready, remaining = PlantService.GetProgress(p, d)
			T.ok(not ready)
			T.ok(prog < 0.1)
			T.ok(remaining > 0)
			T.eq((PlantService.Harvest(d, 1)), false)
			p.plantedAt -= Seeds.Get("SunBloom").growTimeSeconds
			prog, ready = PlantService.GetProgress(p, d)
			T.ok(ready)
			T.eq(prog, 1)
		end)

		T.it("growth upgrades shorten time, floored at 40%", function()
			local d = F.newData({ upgrades = { extraSlots = 0, growthSpeedLevel = Game.GROWTH_SPEED_MAX_LEVEL } })
			local grow = Seeds.Get("StarRoot").growTimeSeconds
			local factor = math.max(0.4, 1 - Game.GROWTH_SPEED_MAX_LEVEL * Game.GROWTH_SPEED_PER_LEVEL)
			local plant = { seedId = "StarRoot", slotIndex = 1, plantedAt = os.time() - math.ceil(grow * factor) }
			local _, ready = PlantService.GetProgress(plant, d)
			T.ok(ready, "upgraded plant should be ready")
			local d0 = F.newData()
			local _, ready0 = PlantService.GetProgress(plant, d0)
			T.ok(not ready0, "unupgraded should not be ready")
		end)

		T.it("Harvest gives crop token and frees slot", function()
			local d = F.newData({ inventory = { DewLeaf = 1 } })
			PlantService.Plant(d, "DewLeaf", 3)
			PlantService.InstantGrowAll(d)
			local ok, _, value = PlantService.Harvest(d, 3)
			T.ok(ok)
			T.eq(value, Seeds.Get("DewLeaf").sellPrice)
			T.eq(d.inventory["crop:DewLeaf"], 1)
			T.eq(d.totalHarvested, 1)
			T.eq(#d.plants, 0)
			T.eq((PlantService.Harvest(d, 3)), false)
		end)

		T.it("Harvest clears unknown plant", function()
			local d = F.newData({ plants = { { seedId = "Ghost", slotIndex = 1, plantedAt = 0 } } })
			T.eq((PlantService.Harvest(d, 1)), false)
			T.eq(#d.plants, 0)
		end)

		T.it("AutoHarvestReady only harvests ripe plants", function()
			local d = F.newData({ inventory = { SunBloom = 2 } })
			PlantService.Plant(d, "SunBloom", 1)
			PlantService.Plant(d, "SunBloom", 2)
			d.plants[1].plantedAt -= 10000
			T.eq(PlantService.AutoHarvestReady(d), 1)
			T.eq(#d.plants, 1)
			T.eq(d.plants[1].slotIndex, 2)
		end)
	end)
end
